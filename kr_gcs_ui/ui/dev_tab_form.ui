 <class>DevTabForm</class>
 <widget class="QWidget" name="DevTabForm">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>907</width>
    <height>609</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>Form</string>
  </property>
  <property name="styleSheet">
   <string notr="true">#DevTabForm{
	background-color:#FFFFFF;
}

#pushButton_custom_cmd{
	background-color:#555555;
	color:#FFFFFF;
}

#pushButton_reset_position{
	background-color:#555555;
	color:#FFFFFF;
}

#pushButton_set_elec_angle{
	background-color:#555555;
	color:#FFFFFF;
}

#spinBox_elec_angle{
	color:#000000;
	background-color:#FFFFFF;
	border:1px solid #888888;
	border-radius:5px;
	padding:2px;
	min-width:80px;
}

#groupBox_fw_update{
	color:#000000;
	border:1px solid #888888;
	border-radius:5px;
	margin-top:8px;
	padding-top:6px;
}

#groupBox_fw_update::title{
	subcontrol-origin: margin;
	subcontrol-position: top left;
	padding:0 4px;
	color:#000000;
}

#pushButton_fw_browse, #pushButton_fw_start, #pushButton_fw_cancel{
	background-color:#555555;
	color:#FFFFFF;
	padding:4px 10px;
	border-radius:4px;
}

#pushButton_fw_start:disabled, #pushButton_fw_cancel:disabled{
	background-color:#BBBBBB;
	color:#FFFFFF;
}

#lineEdit_fw_path{
	color:#000000;
	background-color:#FFFFFF;
	border:1px solid #888888;
	border-radius:4px;
	padding:2px 4px;
}

#textEdit_fw_log{
	color:#000000;
	background-color:#FAFAFA;
	border:1px solid #888888;
	border-radius:4px;
	font-family:Consolas, monospace;
	font-size:11px;
}

#progressBar_fw{
	border:1px solid #888888;
	border-radius:4px;
	text-align:center;
	background-color:#FFFFFF;
}

#progressBar_fw::chunk{
	background-color:#4A90E2;
	border-radius:3px;
}

#pushButton_set_p_gain{
	background-color:#555555;
	color:#FFFFFF;
}

#pushButton_set_v_gain{
	background-color:#555555;
	color:#FFFFFF;
}

#pushButton_set_c_gain{
	background-color:#555555;
	color:#FFFFFF;
}
</string>
