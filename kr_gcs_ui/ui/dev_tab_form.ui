     <widget class="QWidget" name="tab_dev_firmware">
      <attribute name="title">
       <string>Firmware Update</string>
      </attribute>
      <layout class="QVBoxLayout" name="verticalLayout_tab_firmware">
       <item>
        <widget class="QGroupBox" name="groupBox_fw_update">
         <property name="font">
          <font>
           <family>Noto Sans KR</family>
           <pointsize>13</pointsize>
           <weight>75</weight>
           <bold>true</bold>
          </font>
         </property>
         <property name="title">
          <string>Firmware Update (Bootloader)</string>
         </property>
         <layout class="QVBoxLayout" name="verticalLayout_fw">
          <item>
           <layout class="QHBoxLayout" name="horizontalLayout_fw_file">
            <item>
             <widget class="QLabel" name="label_fw_path">
              <property name="font">
               <font>
                <family>Noto Sans KR</family>
                <pointsize>11</pointsize>
               </font>
              </property>
              <property name="text">
               <string>.bin file</string>
              </property>
             </widget>
            </item>
            <item>
             <widget class="QLineEdit" name="lineEdit_fw_path">
              <property name="font">
               <font>
                <family>Noto Sans KR</family>
                <pointsize>11</pointsize>
               </font>
              </property>
              <property name="placeholderText">
               <string>Select application .bin (linked at 0x08008000)</string>
              </property>
             </widget>
            </item>
            <item>
             <widget class="QPushButton" name="pushButton_fw_browse">
              <property name="font">
               <font>
                <family>Noto Sans KR</family>
                <pointsize>11</pointsize>
                <weight>75</weight>
                <bold>true</bold>
               </font>
              </property>
              <property name="text">
               <string>Browse...</string>
              </property>
             </widget>
            </item>
           </layout>
          </item>
          <item>
           <layout class="QHBoxLayout" name="horizontalLayout_fw_opts">
            <item>
             <widget class="QCheckBox" name="checkBox_fw_auto_reset">
              <property name="font">
               <font>
                <family>Noto Sans KR</family>
                <pointsize>11</pointsize>
               </font>
              </property>
              <property name="text">
               <string>Auto-enter bootloader (send SYSTEM_RESET via Modbus)</string>
              </property>
              <property name="checked">
               <bool>true</bool>
              </property>
             </widget>
            </item>
            <item>
             <widget class="QCheckBox" name="checkBox_fw_jump">
              <property name="font">
               <font>
                <family>Noto Sans KR</family>
                <pointsize>11</pointsize>
               </font>
              </property>
              <property name="text">
               <string>Boot into app after update</string>
              </property>
              <property name="checked">
               <bool>true</bool>
              </property>
             </widget>
            </item>
            <item>
             <spacer name="horizontalSpacer_fw">
              <property name="orientation">
               <enum>Qt::Horizontal</enum>
              </property>
              <property name="sizeHint" stdset="0">
               <size>
                <width>20</width>
                <height>20</height>
               </size>
              </property>
             </spacer>
            </item>
           </layout>
          </item>
          <item>
           <layout class="QHBoxLayout" name="horizontalLayout_fw_btns">
            <item>
             <widget class="QPushButton" name="pushButton_fw_start">
              <property name="font">
               <font>
                <family>Noto Sans KR</family>
                <pointsize>12</pointsize>
                <weight>75</weight>
                <bold>true</bold>
               </font>
              </property>
              <property name="text">
               <string>Start Firmware Update</string>
              </property>
             </widget>
            </item>
            <item>
             <widget class="QPushButton" name="pushButton_fw_cancel">
              <property name="font">
               <font>
                <family>Noto Sans KR</family>
                <pointsize>12</pointsize>
                <weight>75</weight>
                <bold>true</bold>
               </font>
              </property>
              <property name="text">
               <string>Cancel</string>
              </property>
              <property name="enabled">
               <bool>false</bool>
              </property>
             </widget>
            </item>
           </layout>
          </item>
          <item>
           <widget class="QProgressBar" name="progressBar_fw">
            <property name="value">
             <number>0</number>
            </property>
           </widget>
          </item>
          <item>
