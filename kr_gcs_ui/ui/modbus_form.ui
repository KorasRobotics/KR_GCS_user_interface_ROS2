  <property name="styleSheet">
   <string notr="true">#ModbusForm{
	background-color:#FFFFFF;
}

#comboBox_baudrate {
	padding-left: 62px;
	border-radius:5px;
}

#comboBox_serial_port {
	border-radius:5px;
    text-align: center;
}

#pushButton_modbus_refresh {
	background-color:#888888;
}

#line{
	color:#555555;
}

#frame{
	background-color:#888888;
	border-radius:5px;
}

#label_1{
	color:#FFFFFF;
}

#label_2{
	color:#FFFFFF;
}

#label_3{
	color:#FFFFFF;
}

#pushButton_modbus_start{
	background-color:#555555;
	color:#FFFFFF;

	border-top-left-radius:20px;
	border-bottom-left-radius:20px;
}

#pushButton_modbus_stop{
	background-color:#555555;
	color:#FFFFFF;
	border-top-right-radius:20px;
	border-bottom-right-radius:20px;
}

#pushButton_modbus_slave_change{
	background-color:#555555;
	color:#FFFFFF;
	border-radius:20px
}

#pushButton_modbus_set_slave_addr{
	background-color:#555555;
	color:#FFFFFF;
	border-top-right-radius:20px;
	border-bottom-right-radius:20px;
}

#label_5{
	color:#000000;
}

#spinBox_slave_addr_4set{
	color:#000000;
	background-color:#FFFFFF;
	border:1px solid #888888;
	border-radius:5px;
	padding:2px;
	min-width:80px;
}

QSpinBox::up-button{
	subcontrol-origin: border;
	subcontrol-position: top right;
	width:16px;
	border-left:1px solid #B0B0B0;
	border-bottom:1px solid #B0B0B0;
	background-color:#F0F0F0;
}

QSpinBox::up-button:hover{
	background-color:#E0E0E0;
}

QSpinBox::up-button:pressed{
	background-color:#C8C8C8;
}

QSpinBox::up-arrow{
	image: url(:/black_icons/black/chevron-up.svg);
	width:9px;
	height:9px;
}

QSpinBox::down-button{
	subcontrol-origin: border;
	subcontrol-position: bottom right;
	width:16px;
	border-left:1px solid #B0B0B0;
	background-color:#F0F0F0;
}

QSpinBox::down-button:hover{
	background-color:#E0E0E0;
}

QSpinBox::down-button:pressed{
	background-color:#C8C8C8;
}

QSpinBox::down-arrow{
	image: url(:/black_icons/black/chevron-down.svg);
	width:9px;
	height:9px;
}

#pushButton_repeat_start, #pushButton_repeat_reset, #pushButton_repeat_stop, #pushButton_repeat_command_status_clear{
	background-color:#555555;
	color:#FFFFFF;
	border-radius:15px;
	padding:4px 10px;
}

#pushButton_repeat_start:pressed, #pushButton_repeat_reset:pressed, #pushButton_repeat_stop:pressed, #pushButton_repeat_command_status_clear:pressed{
	background-color:#333333;
}

#doubleSpinBox_repeat_open_delay, #doubleSpinBox_repeat_close_delay, #doubleSpinBox_repeat_target{
	color:#000000;
	background-color:#FFFFFF;
	border:1px solid #888888;
	border-radius:5px;
	padding:2px;
	min-width:80px;
}

QDoubleSpinBox::up-button{
	subcontrol-origin: border;
	subcontrol-position: top right;
	width:16px;
	border-left:1px solid #B0B0B0;
	border-bottom:1px solid #B0B0B0;
	background-color:#F0F0F0;
}

QDoubleSpinBox::up-button:hover, QDoubleSpinBox::down-button:hover{
	background-color:#E0E0E0;
}

QDoubleSpinBox::up-button:pressed, QDoubleSpinBox::down-button:pressed{
	background-color:#C8C8C8;
}

QDoubleSpinBox::up-arrow{
	image: url(:/black_icons/black/chevron-up.svg);
	width:9px;
	height:9px;
}

QDoubleSpinBox::down-button{
	subcontrol-origin: border;
	subcontrol-position: bottom right;
	width:16px;
	border-left:1px solid #B0B0B0;
	background-color:#F0F0F0;
}

QDoubleSpinBox::down-arrow{
	image: url(:/black_icons/black/chevron-down.svg);
	width:9px;
	height:9px;
}

#label_repeat_cnt{
	color:#000000;
	border:1px solid #888888;
	border-radius:5px;
	padding:2px;
}

#label_repeat_error_code{
	color:#B00000;
	font-weight:bold;
}

#plainTextEdit_repeat_command_status{
	border:1px solid #888888;
	border-radius:5px;
}

